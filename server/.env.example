# image-hub server environment
#
# Copy to .env and fill in. NEVER commit .env. Bckup: §3.8 で .env を exclude.

# --- Public URLs ---
IMAGEHUB_PUBLIC_MCP_URL=https://image-hub.your-host.example.com/mcp
IMAGEHUB_PUBLIC_AUTH_URL=https://image-hub.your-host.example.com

# --- OAuth secrets ---
# 生成: openssl rand -base64 64
IMAGEHUB_OAUTH_SIGNING_KEY=change-me-to-a-long-random-string

# 生成: openssl rand -base64 18
IMAGEHUB_ADMIN_PASSCODE=change-me-to-something-only-you-know

# --- HermesAgent (X / Grok Imagine 経由の画像生成) ---
# openai-image-mcp service の中身は kazyam53/openai_gen_image_mcp から
# HermesAgent ラッパに差し替え済 (OpenAI 課金から脱却)。 認証は MCP 標準の
# OAuth 2.1 (DCR + authorization_code + refresh_token rotation)。 初回 consent は
# bootstrap_oauth.py をローカルで 1 回だけ走らせて state を生成 → prod に scp。
HERMES_MCP_URL=https://hermes.your-host.example.com/mcp
# server.py が token を読み書きするパス。 compose.yml で
# /path/to/image-hub/hermes_oauth:/var/lib/hermes-oauth の bind mount を張る。
HERMES_OAUTH_STATE_PATH=/var/lib/hermes-oauth/state.json

# --- Logging ---
LOG_LEVEL=info
